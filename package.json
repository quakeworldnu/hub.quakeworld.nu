{
  "name": "qw-server-browser",
  "version": "0.1.0",
  "description": "QuakeWorld Server Browser",
  "author": "Viktor Persson",
  "license": "MIT",
  "repository": "vikpe/qw-server-browser",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "biome check --write src",
    "lint": "biome lint src",
    "test": "vitest --coverage",
    "test:watch": "vitest --watch --coverage",
    "bench": "vitest bench --run",
    "supabase:types": "supabase gen types typescript --project-id ncsphkjfominimxztjip > src/pages/games/services/supabase/database.types.ts",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@swc/core": "^1.16.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "jsdom": "^30.1.3",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@supabase/postgrest-js": "2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-swipeable": "^7.0.2",
    "remeda": "^2.53.0",
    "use-double-tap": "^1.3.7",
    "use-long-press": "^3.3.0",
    "usehooks-ts": "^3.1.1"
  }
}
