{
  "name": "qw-server-browser",
  "version": "0.1.0",
  "description": "QuakeWorld Server Browser",
  "author": "Viktor Persson",
  "license": "MIT",
  "repository": "vikpe/qw-server-browser",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "biome check --write src",
    "lint": "biome lint src",
    "test": "vitest --coverage",
    "test:watch": "vitest --watch --coverage",
    "bench": "vitest bench --run",
    "supabase:types": "supabase gen types typescript --project-id ncsphkjfominimxztjip > src/pages/games/services/supabase/database.types.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/react": "^18.3.13",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "supabase": "^2.34.3",
    "typescript": "^5.7.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.1",
    "@radix-ui/react-dialog": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-switch": "^1.1.2",
    "@supabase/postgrest-js": "1.19.4",
    "@tanstack/react-query": "^5.104.5",
    "autoprefixer": "^10.4.20",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "copy-text-to-clipboard": "^3.2.0",
    "dayjs": "^1.11.13",
    "formik": "^2.4.6",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "query-string": "^8.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-idle-timer": "^5.7.2",
    "react-modern-drawer": "^1.4.0",
    "react-range": "^1.10.0",
    "react-swipeable": "^7.0.2",
    "react-toastify": "^9.1.3",
    "remeda": "^2.17.4",
    "sass": "^1.83.0",
    "screenfull": "^6.0.2",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.16",
    "tailwindcss-animate": "^1.0.7",
